  - m_Id: 3216632207249408
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 3514287382728704
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043A\u043E\u0440\u0430\u0431\u043B\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 3514287424671744
    m_Localized: "\u042D\u0442\u043E \u0441\u043E\u044E\u0437\u043D\u044B\u0439 \u043F\u043E\u0440\u0442
      - \u0442\u0432\u043E\u044F \u0446\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866048
    m_Localized: "\u0422\u0432\u043E\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C
      \xAB\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0441\u043B\u0430\u0434\u043E\u0441\u0442\u0435\u0439\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866049
    m_Localized: "\u0420\u0435\u0433\u0443\u043B\u044F\u0442\u043E\u0440 \u0442\u044F\u0433\u0438,
      \u0447\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C,
      \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0440\u0430\u0441\u0445\u043E\u0434 \u0442\u043E\u043F\u043B\u0438\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866050
    m_Localized: "\u041F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439,
      \u0437\u0430\u0436\u0438\u043C\u0430\u044F \u043A\u043D\u043E\u043F\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866051
    m_Localized: "\u041F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0442\u0432\u043E\u0435\u0433\u043E
      \u043A\u043E\u0440\u0430\u0431\u043B\u044F. \u0421\u043B\u0435\u0434\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430 \u043D\u0435 \u0443\u043F\u0430\u043B\u0430
      \u0434\u043E 0"
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866052
    m_Localized: "\u0422\u0432\u043E\u0438 \u0437\u0430\u043F\u0430\u0441\u044B \u0442\u043E\u043F\u043B\u0438\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866053
    m_Localized: "\u0412\u0440\u0430\u0436\u0435\u0441\u043A\u0430\u044F \u0440\u0430\u043A\u0435\u0442\u0430.
      \u041C\u043E\u0436\u0435\u0442 \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043C\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866054
    m_Localized: "\u0417\u0430\u0445\u0432\u0430\u0442 \u0446\u0435\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866055
    m_Localized: "1 - \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0440\u0430\u0434\u0430\u0440, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0442\u044C
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u0440\u0430\u043A\u0435\u0442\u044B.
      \u0420\u0430\u0434\u0430\u0440 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D
      \u043D\u0430 \u043D\u043E\u0441\u0443 \u043A\u043E\u0440\u0430\u0431\u043B\u044F,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439\u0442\u0435
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C.\n\n2
      - \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0440\u0443\u0447\u043A\u0443
      \u0430\u043D\u0442\u0435\u043D\u043D\u044B, \u0447\u0442\u043E\u0431\u044B
      \u0442\u043E\u0447\u043D\u043E \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0441\u0438\u0433\u043D\u0430\u043B\u0430.\n\n3
      - \u0424\u0438\u043A\u0441\u0438\u0440\u0443\u0439\u0442\u0435 \u0430\u043D\u0442\u0435\u043D\u043D\u0443,
      \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u0435\u0451 \u043D\u0430 \u0446\u0435\u043B\u044C. \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442
      \u0432\u0430\u043C \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F
      \u043A \u0440\u0430\u043A\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866056
    m_Localized: "1 - \u0414\u043B\u044F \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
      \u043A \u0440\u0430\u043A\u0435\u0442\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u0440\u043E\u0432\u0430\u0442\u044C
      \u043E\u0448\u0438\u0431\u043A\u0438.\n\n2 - \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043F\u0430\u043D\u0435\u043B\u044C \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
      \u043C\u0435\u0436\u0434\u0443 \u0431\u0438\u0442\u0430\u043C\u0438 \u0438
      \u0434\u043B\u044F \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u043A\u0438
      \"\u043A\u0440\u0430\u0441\u043D\u044B\u0445\" \u0431\u0438\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866057
    m_Localized: "1 - \u0414\u043B\u044F \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
      \u043A \u0440\u0430\u043A\u0435\u0442\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B.\n\n2 - \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043F\u0430\u043D\u0435\u043B\u044C \u0434\u043B\u044F \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F
      \u0447\u0430\u0441\u0442\u043E\u0442\u044B \u0438 \u0430\u043C\u043B\u0438\u0442\u0443\u0434\u044B.
      \u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043D\u0430\u0448\u0438 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B
      \u0441 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u043C\u0438 \u0440\u0430\u043A\u0435\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866058
    m_Localized: "\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u0435
      \u0440\u0430\u043A\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866059
    m_Localized: "1 - \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0438 \u0441\u0435\u0440\u0438\u0439\u043D\u044B\u0439
      \u043D\u043E\u043C\u0435\u0440 \u0440\u0430\u043A\u0435\u0442\u044B.\n\n2 -
      \u041E\u0441\u043E\u0431\u044B\u0439 \u0441\u0438\u043C\u0432\u043E\u043B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u044B
      \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A \u0440\u0435\u0448\u0438\u043B\u0438
      \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C \u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u0435.\n\n3
      - \u0414\u043B\u0438\u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866060
    m_Localized: "\u041F\u0430\u043D\u0435\u043B\u044C \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u0441\u0438\u0433\u043D\u0430\u043B\u043E\u043C.\n\n\u0414\u043B\u044F \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u044F
      \u0440\u0430\u043A\u0435\u0442 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043F\u043E\u0434\u0430\u0442\u044C \u043E\u0441\u043E\u0431\u044B\u0439 \u0441\u0438\u0433\u043D\u0430\u043B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
      \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0435\u0439 \u0440\u0430\u043A\u0435\u0442\u044B.\n\n1
      - \u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u0438
      \u0431\u0438\u0442\u043E\u0432, \u043D\u0443\u0436\u043D\u044B, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0446\u0435\u043B\u044C.\n\n2 - \u0421\u043F\u043E\u0441\u043E\u0431 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F
      \u0440\u0430\u043A\u0435\u0442\u044B.\n\n3 - \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \xAB\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u0438\u0433\u043D\u0430\u043B\xBB,
      \u043A\u043E\u0433\u0434\u0430 \u0443\u0432\u0435\u0440\u0435\u043D\u044B,
      \u0447\u0442\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0432\u0441\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0440\u0430\u043A\u0435\u0442\u044B.\n\n\u0415\u0441\u043B\u0438
      \u0432\u0441\u0451 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043E \u043F\u043E
      \u0438\u043D\u0441\u0442\u0440\u0443\u0446\u0438\u0438, \u0442\u043E \u0440\u0430\u043A\u0435\u0442\u0430
      \u0431\u0443\u0434\u0435\u0442 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866061
    m_Localized: "\u0418\u041D\u0421\u0422\u0420\u0423\u041A\u0426\u0418\u042F \u041F\u041E
      \u041E\u0411\u0415\u0417\u0412\u0420\u0415\u0416\u0418\u0412\u0410\u041D\u0418\u042E
      \u0420\u0410\u041A\u0415\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866062
    m_Localized: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u0443.
      \u041D\u0430\u0439\u0434\u0438 \u043F\u0435\u0440\u0432\u043E\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0435
      \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u0432 \u0441\u043F\u0438\u0441\u043A\u0435
      \u043D\u0438\u0436\u0435. \u041A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E
      \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u043F\u043E\u0434\u043E\u0448\u043B\u043E
      \u2013 \u0441\u0440\u0430\u0437\u0443 \u0432\u044B\u0431\u0438\u0440\u0430\u0439
      \u043D\u0443\u0436\u043D\u044B\u0439 \u0440\u0435\u0436\u0438\u043C. \u0414\u0430\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866063
    m_Localized: "1. <b>\u0422\u0415\u041F\u041B\u041E\u0412\u041E\u0415</b>, \u0435\u0441\u043B\u0438:\n  
      - \u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u0435 \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D
      <b>\u043A\u0440\u0443\u0433</b> \u0418 \u0435\u0451 \u0434\u043B\u0438\u043D\u0430
      <b>\u043C\u0435\u043D\u044C\u0448\u0435 4 \u043C\u0435\u0442\u0440\u043E\u0432</b>,
      \u0418\u041B\u0418\n   - \u0432 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0438
      \u0435\u0441\u0442\u044C <b>\xABR-\xBB</b> (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      R-77).\n\n2. <b>\u041B\u0410\u0417\u0415\u0420\u041D\u041E\u0415</b>, \u0435\u0441\u043B\u0438:\n  
      - \u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u0435 <b>\u043A\u0432\u0430\u0434\u0440\u0430\u0442</b>
      \u0418 \u0432 \u0441\u0435\u0440\u0438\u0439\u043D\u043E\u043C \u043D\u043E\u043C\u0435\u0440\u0435
      \u0435\u0441\u0442\u044C \u0431\u0443\u043A\u0432\u0430 <b>Z</b>, \u0418\u041B\u0418\n  
      - \u0434\u043B\u0438\u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u044B <b>6
      \u043C\u0435\u0442\u0440\u043E\u0432 \u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435</b>.\n\n3.
      <b>\u0422\u0415\u041F\u041B\u041E\u0412\u041E\u0415</b>, \u0435\u0441\u043B\u0438:\n  
      - \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 <b>\u0447\u0451\u0442\u043D\u0443\u044E \u0446\u0438\u0444\u0440\u0443</b>
      (0, 2, 4, 6, 8), \u0418\u041B\u0418\n   - \u0441\u0435\u0440\u0438\u0439\u043D\u044B\u0439
      \u043D\u043E\u043C\u0435\u0440 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0431\u0443\u043A\u0432\u044B <b>X</b>.\n\n4. <b>\u041B\u0410\u0417\u0415\u0420\u041D\u041E\u0415</b>,
      \u0435\u0441\u043B\u0438:\n   - \u0441\u0435\u0440\u0438\u0439\u043D\u044B\u0439
      \u043D\u043E\u043C\u0435\u0440 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 <b>\u043E\u0434\u043D\u0443 \u0438 \u0442\u0443 \u0436\u0435 \u0431\u0443\u043A\u0432\u0443</b>,
      \u0418\u041B\u0418\n   - \u0441\u0443\u043C\u043C\u0430 \u0432\u0441\u0435\u0445
      \u0446\u0438\u0444\u0440 \u0432 \u0441\u0435\u0440\u0438\u0439\u043D\u043E\u043C
      \u043D\u043E\u043C\u0435\u0440\u0435 <b>\u0431\u043E\u043B\u044C\u0448\u0435
      30</b>.\n\n5. \u0415\u0441\u043B\u0438 \u043D\u0438 \u043E\u0434\u043D\u043E
      \u0438\u0437 \u0443\u0441\u043B\u043E\u0432\u0438\u0439 1\u20134 \u043D\u0435
      \u043F\u043E\u0434\u043E\u0448\u043B\u043E \u2013 \u0432\u044B\u0431\u0438\u0440\u0430\u0439
      <b>\u0422\u0415\u041F\u041B\u041E\u0412\u041E\u0415</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866064
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u0443 \u0441\u043D\u043E\u0432\u0430.
      <b>\u041D\u0430\u0436\u043C\u0438 \u043A\u0430\u0436\u0434\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443
      \u043E\u0442 1 \u0434\u043E 8</b>, \u0434\u043B\u044F \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0432\u0435\u0440\u043D\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u0435.
      \u041A\u043D\u043E\u043F\u043A\u0438 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0436\u0438\u043C\u0430\u0442\u044C
      \u0432 \u043B\u044E\u0431\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435.
      \u0415\u0441\u043B\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u043D\u0435
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u2013 \u043A\u043D\u043E\u043F\u043A\u0443
      \u043D\u0435 \u043D\u0430\u0436\u0438\u043C\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 3514287428866065
    m_Localized: "<b>1</b> \u2013 (\u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u0435
      <b>\u0437\u0432\u0435\u0437\u0434\u0430</b> \u0418 \u0434\u043B\u0438\u043D\u0430
      \u2013 <b>\u0446\u0435\u043B\u043E\u0435 \u0447\u0438\u0441\u043B\u043E</b>,
      \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 4.0, 5.0, 8.0) \u0418\u041B\u0418
      (\u0432 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0438 \u0435\u0441\u0442\u044C
      <b>\xABMIM\xBB</b>)\n\n<b>2</b> \u2013 (\u0432 \u0441\u0435\u0440\u0438\u0439\u043D\u043E\u043C
      \u043D\u043E\u043C\u0435\u0440\u0435 \u0435\u0441\u0442\u044C <b>\u0442\u0440\u0438
      \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0445 \u0441\u0438\u043C\u0432\u043E\u043B\u0430
      \u043F\u043E\u0434\u0440\u044F\u0434</b>, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440
      AAA, 111, ZZZ) \u0418\u041B\u0418 (\u0434\u043B\u0438\u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u044B
      <b>\u043C\u0435\u043D\u044C\u0448\u0435 3 \u043C\u0435\u0442\u0440\u043E\u0432</b>)\n\n<b>3</b>
      \u2013 (\u0432 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0438 \u0435\u0441\u0442\u044C
      <b>\xABFAB\xBB</b>) \u0418\u041B\u0418 (\u0432 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0438
      \u0435\u0441\u0442\u044C <b>\xABAGM\xBB</b>)\n\n<b>4</b> \u2013 (\u0434\u043B\u0438\u043D\u0430
      \u0440\u0430\u043A\u0435\u0442\u044B <b>\u0431\u043E\u043B\u044C\u0448\u0435
      7 \u043C\u0435\u0442\u0440\u043E\u0432</b>) \u0418\u041B\u0418 (\u043D\u0430
      \u0440\u0430\u043A\u0435\u0442\u0435 <b>\u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A</b>
      \u0418 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0446\u0438\u0444\u0440\u0430
      \u0441\u0435\u0440\u0438\u0439\u043D\u043E\u0433\u043E \u043D\u043E\u043C\u0435\u0440\u0430
      \u0440\u0430\u0432\u043D\u0430 <b>0</b>)\n\n<b>5</b> \u2013 (\u0441\u0443\u043C\u043C\u0430
      \u0432\u0441\u0435\u0445 \u0446\u0438\u0444\u0440 \u0432 \u0441\u0435\u0440\u0438\u0439\u043D\u043E\u043C
      \u043D\u043E\u043C\u0435\u0440\u0435 \u2013 <b>\u0447\u0451\u0442\u043D\u0430\u044F</b>)
      \u0418\u041B\u0418 (\u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u0435 <b>\u043A\u0440\u0443\u0433</b>
      \u0418 \u0434\u043B\u0438\u043D\u0430 <b>5 \u043C\u0435\u0442\u0440\u043E\u0432
      \u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435</b>)\n\n<b>6</b> \u2013
      (\u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u0435 <b>\u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A</b>
      \u0418 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0446\u0438\u0444\u0440\u0430
      \u0441\u0435\u0440\u0438\u0439\u043D\u043E\u0433\u043E \u043D\u043E\u043C\u0435\u0440\u0430
      \u2013 <b>\u043D\u0435\u0447\u0451\u0442\u043D\u0430\u044F</b>) \u0418\u041B\u0418
      (\u0434\u043B\u0438\u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u044B <b>\u043E\u0442
      4 \u0434\u043E 6 \u043C\u0435\u0442\u0440\u043E\u0432 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E</b>)\n\n<b>7</b>
      \u2013 (\u0432 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0438 \u0435\u0441\u0442\u044C
      <b>\u0434\u0435\u0444\u0438\u0441 \xAB-\xBB</b>) \u0418\u041B\u0418 (\u0441\u0435\u0440\u0438\u0439\u043D\u044B\u0439
      \u043D\u043E\u043C\u0435\u0440 <b>\u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0431\u0443\u043A\u0432\u0443</b>)\n\n<b>8</b> \u2013 \u041D\u0430\u0436\u0438\u043C\u0430\u0439
      \u043A\u043D\u043E\u043F\u043A\u0443 8 <b>\u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430 \u043D\u0438
      \u043E\u0434\u043D\u043E \u0438\u0437 \u0443\u0441\u043B\u043E\u0432\u0438\u0439
      1\u20137 \u043D\u0435 \u043F\u043E\u0434\u043E\u0448\u043B\u043E</b>. \u0415\u0441\u043B\u0438
      \u0445\u043E\u0442\u044C \u043E\u0434\u043D\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u0435
      \u0438\u0437 1\u20137 \u0432\u0435\u0440\u043D\u043E \u2013 \u043A\u043D\u043E\u043F\u043A\u0443
      8 \u043D\u0430\u0436\u0438\u043C\u0430\u0442\u044C \u041D\u0415\u041B\u042C\u0417\u042F."
    m_Metadata:
      m_Items: []
