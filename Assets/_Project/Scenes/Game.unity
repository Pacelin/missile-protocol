--- !u!114 &450542891
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 450542889}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>1</b> \u2013 (a <b>star</b> on the missile <b>AND</b> length is an
    <b>integer</b>, e.g. 4.0, 5.0, 8.0) <b>OR</b> (the name contains <b>\xABMIM\xBB</b>)\n\n<b>2</b>
    \u2013 (the serial number has <b>three identical symbols in a row</b>, e.g. AAA,
    111, ZZZ) <b>OR</b> (missile length <b>less than 3 metres</b>)\n\n<b>3</b> \u2013
    (the name contains <b>\xABFAB\xBB</b>) <b>OR</b> (the name contains <b>\xABAGM\xBB</b>)\n\n<b>4</b>
    \u2013 (missile length <b>greater than 7 metres</b>) <b>OR</b> (a <b>triangle</b>
    on the missile <b>AND</b> the last digit of the serial number equals <b>0</b>)\n\n<b>5</b>
    \u2013 (the sum of all digits in the serial number is <b>even</b>) <b>OR</b>
    (a <b>circle</b> on the missile <b>AND</b> length <b>5 metres or more</b>)\n\n<b>6</b>
    \u2013 (a <b>triangle</b> on the missile <b>AND</b> the last digit of the serial
    number is <b>odd</b>) <b>OR</b> (missile length <b>from 4 to 6 metres inclusive</b>)\n\n<b>7</b>
    \u2013 (the name contains a <b>hyphen \xAB-\xBB</b>) <b>OR</b> (the serial number
    <b>ends with a letter</b>)\n\n<b>8</b> \u2013 Press button 8 <b>only when none
    of conditions 1\u20137 apply</b>. If at least one condition from 1\u20137 is
    true, you MUST NOT press button 8."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e221bb206d4b54840a13043f81985747, type: 2}
  m_sharedMaterial: {fileID: 8006985742711815183, guid: e221bb206d4b54840a13043f81985747, type: 2}
